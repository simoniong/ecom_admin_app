<div class="p-6">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-semibold text-gray-900">
      <%= t("packages.title") %>
      <span class="text-base font-normal text-gray-500">&middot; <%= t("packages.states.#{@state}") %></span>
    </h1>
    <%= button_to t("packages.sync_orders"), sync_packages_path, method: :post,
        class: "px-3 py-1.5 text-sm bg-blue-600 text-white rounded hover:bg-blue-700" %>
  </div>

  <% if @state == "applying_tracking" %>
    <nav class="flex gap-4 border-b border-gray-200 mb-4">
      <%= link_to t("packages.application_status.all"), packages_list_path(application_status: nil, page: nil),
            class: "pb-2 text-sm font-medium #{params[:application_status].blank? ? 'border-b-2 border-gray-900 text-gray-900' : 'text-gray-500 hover:text-gray-700'}" %>
      <% PackagesController::APPLICATION_STATUSES.each do |status| %>
        <%= link_to t("packages.application_status.#{status}"), packages_list_path(application_status: status, page: nil),
              class: "pb-2 text-sm font-medium #{params[:application_status] == status ? 'border-b-2 border-gray-900 text-gray-900' : 'text-gray-500 hover:text-gray-700'}" %>
      <% end %>
    </nav>
  <% end %>

  <%= render "packages/filter_bar", countries: @countries, country: @country,
        sort_column: @sort_column, sort_direction: @sort_direction,
        stores: visible_shopify_stores.to_a %>

  <% bulk = %w[pending_review pending_process pending_label].include?(@state) %>
  <%
    bulk_url, bulk_label =
      case @state
      when "pending_label"  then [ labels_packages_path, t("packages.label.bulk_button") ]
      when "pending_review" then [ submit_review_bulk_packages_path, t("packages.review.bulk_button") ]
      else                       [ apply_tracking_bulk_packages_path, t("packages.apply.bulk_button") ]
      end
  %>
  <% bulk_html = @state == "pending_label" ? { id: "packages-bulk-form", target: "_blank" } : { id: "packages-bulk-form" } %>
  <%= form_with url: bulk_url, method: :post,
        data: (bulk ? { controller: "package-bulk" } : {}), html: bulk_html do %>
    <% if bulk %>
      <%= hidden_field_tag :country, @country %>
      <%= hidden_field_tag :sort_column, @sort_column %>
      <%= hidden_field_tag :sort_direction, @sort_direction %>
      <div data-package-bulk-target="bar" class="hidden mb-3 flex items-center gap-3 px-4 py-2 bg-indigo-50 border border-indigo-200 rounded">
        <span class="text-sm text-indigo-800"><%= bulk_label %> · <span data-package-bulk-target="count">0</span></span>
        <%= submit_tag bulk_label, formaction: bulk_url, formtarget: (@state == "pending_label" ? "_blank" : nil),
              class: "px-3 py-1.5 text-sm bg-indigo-600 text-white rounded hover:bg-indigo-700 cursor-pointer" %>
        <% if @state == "pending_label" %>
          <%= submit_tag t("packages.ship.bulk_button"), formaction: ship_bulk_packages_path, formtarget: "_self",
                class: "px-3 py-1.5 text-sm bg-emerald-600 text-white rounded hover:bg-emerald-700 cursor-pointer" %>
        <% end %>
      </div>
    <% end %>
    <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <% if bulk %>
                <th class="px-4 py-3"><input type="checkbox" data-action="change->package-bulk#toggleAll" data-package-bulk-target="all"></th>
              <% end %>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("packages.columns.package_code") %></th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("packages.columns.items") %></th>
              <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase"><%= t("packages.columns.order_total") %></th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("packages.columns.destination") %></th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("packages.columns.order_name") %></th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("packages.columns.ordered_at") %> / <%= t("packages.columns.paid_at") %></th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("packages.columns.logistics_channel") %></th>
              <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("packages.columns.status") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100" data-package-bulk-target="<%= "rows" if bulk %>">
            <% if @total_count.zero? %>
              <tr>
                <td colspan="<%= 8 + (bulk ? 1 : 0) %>" class="px-4 py-8 text-center text-sm text-gray-500"><%= t("packages.no_packages") %></td>
              </tr>
            <% else %>
              <% @packages.each do |package| %>
                <%= render "packages/package_row", package: package, bulk: bulk,
                      sibling_index: @sibling_index[package.id] %>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <%= render "packages/pagination", page: @page, total_pages: @total_pages, total_count: @total_count %>
</div>

<div data-controller="modal" data-modal-target="dialog"
     data-action="turbo:frame-load@window->modal#open modal:dismiss@window->modal#close"
     class="hidden fixed inset-0 z-50">
  <div data-modal-target="backdrop" data-action="click->modal#backdropClick"
       class="fixed inset-0 bg-black/50"></div>
  <div class="fixed inset-0 flex items-start justify-center pt-[6vh] px-4 pointer-events-none">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-5xl max-h-[88vh] overflow-y-auto pointer-events-auto">
      <%= turbo_frame_tag "package-modal" %>
    </div>
  </div>
</div>
