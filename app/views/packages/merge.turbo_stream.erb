<%# Mirror of split.turbo_stream.erb: close the modal, then collapse the boxes
    back to a single row where they were. The absorbed boxes no longer exist in
    the database, so their rows have to be removed explicitly — leaving them on
    screen would offer the operator packages that 404 on click.

    That only works when there IS a list row to fold into. The standalone
    /packages/:id page (@standalone, set in #merge from the explicit
    context=standalone param on the merge button — see show.html.erb and
    _siblings_strip) has no such row, and its modal wrapper doesn't listen for
    modal:dismiss, so a dismiss+replace(+remove) stream there would silently do
    nothing. Navigate the whole page back to the list instead, where the
    collapsed box is visible in place. %>
<% if @standalone %>
  <%# state: @survivor.aasm_state (unchanged by a merge — only item quantities
      move) so the operator lands on the filtered list the collapsed box
      actually appears on, not the default pending_review list. %>
  <turbo-stream action="visit" data-url="<%= packages_path(state: @survivor.aasm_state) %>"></turbo-stream>
<% else %>
  <turbo-stream action="dismiss_modal"></turbo-stream>
  <%# Reload with the same eager load #index uses for this partial (:order,
      :shopify_store, :logistics_channel, package_items: { product_variant:
      :product } — the last one is what the SKU thumbnails read) — a bare
      @survivor.reload carries none of it and N+1s per item. %>
  <% survivor = Package.includes(:order, :shopify_store, :logistics_channel,
                                  package_items: { product_variant: :product }).find(@survivor.id) %>
  <% sibling_index = PackageSiblingIndex.new([ survivor ]).call %>
  <%= turbo_stream.replace dom_id(survivor) do %>
    <%= render "packages/package_row", package: survivor, bulk: true,
          sibling_index: sibling_index[survivor.id], flash_highlight: true %>
  <% end %>
  <% @absorbed.each do |box| %>
    <%= turbo_stream.remove dom_id(box) %>
  <% end %>
<% end %>
